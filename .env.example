# .env.example — copy to .env and fill in your values
# .env is gitignored, this file is safe to commit

# MAVLink connection strings per drone
ALPHA_CONNECTION=udp:192.168.1.10:14550
BETA_CONNECTION=udp:192.168.1.11:14550
GAMMA_CONNECTION=udp:192.168.1.12:14550

# GCS relay endpoint (Mission Planner)
GCS_RELAY_URL=udpout:127.0.0.1:14550

# put your AES key here. DO NOT COMMIT IT or I will literally cry.
# generate with: python -c "import secrets; print(secrets.token_hex(32))"
SWARM_AES_KEY=

# leave this empty unless you want to break the SQLite DB
DB_PATH=

# set to 1 to skip real MAVLink and run in simulation mode
SIMULATION=1

# serial port for Pi. if you use anything other than ttyAMA0 you're on your own
SERIAL_PORT=/dev/ttyAMA0
SERIAL_BAUD=921600
